<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="enhancedPwm_tb_behav.wdb" id="1">
         <top_modules>
            <top_module name="enhancedPwm_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000 us"></ZoomStartTime>
      <ZoomEndTime time="50.000001 us"></ZoomEndTime>
      <Cursor1Time time="0.000000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="276"></NameColumnWidth>
      <ValueColumnWidth column_width="111"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="10" />
   <wvobject fp_name="/enhancedPwm_tb/clk_t" type="logic">
      <obj_property name="ElementShortName">clk_t</obj_property>
      <obj_property name="ObjectShortName">clk_t</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/resetn_t" type="logic">
      <obj_property name="ElementShortName">resetn_t</obj_property>
      <obj_property name="ObjectShortName">resetn_t</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/enb_t" type="logic">
      <obj_property name="ElementShortName">enb_t</obj_property>
      <obj_property name="ObjectShortName">enb_t</obj_property>
      <obj_property name="CustomSignalColor">#0000A0</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/pwmSignal_t" type="logic">
      <obj_property name="ElementShortName">pwmSignal_t</obj_property>
      <obj_property name="ObjectShortName">pwmSignal_t</obj_property>
      <obj_property name="CustomSignalColor">#FFD700</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/rollOver_t" type="logic">
      <obj_property name="ElementShortName">rollOver_t</obj_property>
      <obj_property name="ObjectShortName">rollOver_t</obj_property>
      <obj_property name="CustomSignalColor">#FFD700</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/pwmCount_t" type="array">
      <obj_property name="ElementShortName">pwmCount_t[7:0]</obj_property>
      <obj_property name="ObjectShortName">pwmCount_t[7:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="CustomSignalColor">#800080</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/dutyCycle_t" type="array">
      <obj_property name="ElementShortName">dutyCycle_t[8:0]</obj_property>
      <obj_property name="ObjectShortName">dutyCycle_t[8:0]</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
      <obj_property name="CustomSignalColor">#800080</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/uut/E255" type="logic">
      <obj_property name="ElementShortName">E255</obj_property>
      <obj_property name="ObjectShortName">E255</obj_property>
      <obj_property name="CustomSignalColor">#FF0000</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/uut/dutyGreaterCnt" type="logic">
      <obj_property name="ElementShortName">dutyGreaterCnt</obj_property>
      <obj_property name="ObjectShortName">dutyGreaterCnt</obj_property>
      <obj_property name="CustomSignalColor">#FF0000</obj_property>
      <obj_property name="UseCustomSignalColor">true</obj_property>
   </wvobject>
   <wvobject fp_name="/enhancedPwm_tb/uut/control" type="array">
